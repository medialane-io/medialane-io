# SIWS (Sign-In With Starknet) — server-side token verification.
# Must match the value configured in medialane-backend / medialane-starknet.
SIWS_SECRET=

# medialane-backend
NEXT_PUBLIC_MEDIALANE_BACKEND_URL=
# Server-only — used in API routes, never sent to the browser.
MEDIALANE_API_KEY=

# Starknet
# Browser RPC calls should use the same-origin proxy so private RPC keys stay server-side.
NEXT_PUBLIC_STARKNET_PROVIDER_URL=/api/rpc
NEXT_PUBLIC_STARKNET_RPC_URL=
# Server-only RPC endpoint for /api/rpc. Prefer a private provider; the public fallback is rate-limited.
ALCHEMY_RPC_URL=
STARKNET_RPC_URL_SERVER=
STARKNET_RPC_FALLBACK_URL=

# AVNU paymaster — sponsors gas for new-wallet deploys (server-only, never
# NEXT_PUBLIC_*; see /api/wallet/deploy-sponsored/*). Key created in the
# AVNU portal (portal.avnu.fi), funded with STRK credits.
AVNU_PAYMASTER_API_KEY=
# Marketplace/collection contract addresses are no longer overridable here —
# they come straight from the canonical mainnet addresses shipped in
# @medialane/sdk (constants.ts).
# Optional secondary RPC URL, tried alongside ALCHEMY_RPC_URL for /api/rpc.
ALCHEMY_URL=

# IPFS reads only — uploads go through medialane-backend's metered
# /v1/metadata/* Pinata path (MEDIALANE_API_KEY above). io holds no
# Pinata credential of its own.
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud

# Explorer
NEXT_PUBLIC_EXPLORER_URL=https://voyager.online

# Platform fee
# Sends a separate post-settlement ERC-20 transfer to the creators-fund address.
# Requires a rebuild/deploy after changing because these are NEXT_PUBLIC vars.
NEXT_PUBLIC_FEE_ENABLED=true
NEXT_PUBLIC_FEE_FUND_ADDRESS=
NEXT_PUBLIC_FEE_MARKETPLACE_BPS=100
NEXT_PUBLIC_FEE_LAUNCHPAD_BPS=100

# App URL — used for metadata base URL, sitemap generation, and open-redirect validation.
# Must match the domain the app actually serves from, not one that redirects elsewhere —
# medialane.io (apex) 308-redirects to www.medialane.io, so canonical/sitemap/OG URLs built
# from the apex here would all point at a redirecting URL (caught via Search Console
# "Page with redirect" / "Duplicate without user-selected canonical" on 2026-08-16).
NEXT_PUBLIC_APP_URL=https://www.medialane.io
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Genesis Launch Mint
# Contract: IP-Programmable-ERC-721 "MIP" collection (class 0x1bd7...277d7)
NEXT_PUBLIC_LAUNCH_MINT_CONTRACT=0x06ed61abba98a44d45bed2c4b1a456df15053c3321cfd6e007afb33b7226c9f0
# URI must start with ipfs:// or ar://
NEXT_PUBLIC_GENESIS_NFT_URI=
NEXT_PUBLIC_GENESIS_NFT_IMAGE_URL=

# Admin secret for POST /api/pinata/genesis (one-time genesis metadata pre-upload)
ADMIN_SECRET=

# Mail relay — POST /api/internal/send-verification-email, called by
# medialane-backend to deliver connect/sign-up OTP codes.
MAIL_RELAY_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset.
CONTACT_FROM_EMAIL=

# Brazil airdrop campaign (/br/mint) — Portuguese language
NEXT_PUBLIC_BR_MINT_CONTRACT=
NEXT_PUBLIC_BR_NFT_URI=

# Global English airdrop campaign (/mint)
NEXT_PUBLIC_MINT_CONTRACT=
NEXT_PUBLIC_MINT_NFT_URI=
NEXT_PUBLIC_MINT_NFT_IMAGE_URL=
